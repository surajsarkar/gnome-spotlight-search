<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.spotlight-search" path="/org/gnome/shell/extensions/spotlight-search/">
    <key name="toggle-spotlight" type="as">
      <default>['&lt;Super&gt;space']</default>
      <summary>Toggle Spotlight Search</summary>
    </key>
    <key name="theme-mode" type="s">
      <default>'system'</default>
      <summary>Theme mode for Spotlight Search</summary>
      <description>Controls the visual theme: 'system' (follow desktop), 'light', or 'dark'.</description>
    </key>
  </schema>
</schemalist>
